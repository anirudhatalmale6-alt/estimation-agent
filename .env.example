# Azure AD App Registration (for Outlook email trigger + Teams meeting scheduling)
AZURE_CLIENT_ID=<your-azure-app-client-id>
AZURE_CLIENT_SECRET=<your-azure-app-client-secret>
AZURE_TENANT_ID=<your-azure-tenant-id>
AZURE_REFRESH_TOKEN=<your-refresh-token>

# Performance Manager email (receives PET notification emails)
PERF_MANAGER_EMAIL=<your-email@company.com>

# Jira MCP (if using Bedrock Agent Gateway integration)
BEDROCK_GATEWAY_ID=<your-gateway-identifier>
AWS_REGION=us-east-1
ENTRA_USER_OID=<your-entra-object-id>
